{
  "name": "blog.moesegfault.dev",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "test": "vitest run",
    "test:e2e": "pnpm build && pnpm test:e2e:ci",
    "test:e2e:ci": "playwright test --project=chromium --project=firefox --project=webkit --project=mobile-chromium --project=mobile-webkit --project=wechat-android --project=wechat-ios",
    "test:e2e:branded": "pnpm build && playwright test --project=chrome --project=edge",
    "verify:seo": "node scripts/verify-seo-output.mjs",
    "verify:atelier": "node scripts/verify-atelier-build.mjs",
    "test:watch": "vitest",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "browserslist": {
    "production": [
      "Chrome >= 128",
      "Edge >= 128",
      "Firefox >= 134",
      "Safari >= 18.2",
      "iOS >= 18.2"
    ]
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/sitemap": "^3.5.1",
    "@fontsource/noto-sans-sc": "^5.2.6",
    "astro": "^5.13.4",
    "fflate": "^0.8.3",
    "pdfjs-dist": "6.2.108",
    "vite-plugin-static-copy": "^4.1.1"
  },
  "devDependencies": {
    "@astrojs/rss": "^4.0.12",
    "@biomejs/biome": "^2.5.7",
    "@playwright/test": "1.62.1",
    "autoprefixer": "10.5.4",
    "katex": "^0.16.22",
    "postcss": "8.5.26",
    "rehype-katex": "^7.0.1",
    "rehype-stringify": "^10.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "4.4.3",
    "typescript": "^5.9.2",
    "unified": "^11.0.5",
    "vitest": "^4.1.10"
  }
}

---
// src/pages/en/index.astro
import BaseLayout from "@layouts/BaseLayout.astro";
import { useTranslations } from "@i18n/utils";
import "@styles/home.css";
import { getCollection } from "astro:content";
import { createWebSiteJsonLd } from "../../lib/seo";

const lang = "en";
const t = useTranslations(lang);
const pageTitle = "kleedaisuki | Notes on code, math, and ideas";
const structuredData = createWebSiteJsonLd(lang);

const posts = await getCollection(
  "blog",
  ({ data }) => data.locale === lang && !data.draft,
);
const sortedPosts = posts.sort(
  (a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf(),
);
const recentPosts = sortedPosts.slice(0, 3);
---

<BaseLayout
    pageTitle={pageTitle}
    description={t("home.intro")}
    structuredData={structuredData}
>
    <script is:inline>
        /**
         * @brief 在首次绘制前准备标题动画 (prepare title animation before first paint).
         * @note 用户偏好减少动态效果时保留静态标题 (keep the static heading for reduced motion).
         */
        if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
            const root = document.documentElement;
            root.dataset.homeTyping = "true";

            /**
             * @brief 释放未启动动画的首屏兜底 (release a stalled first-paint animation).
             * @return 无返回值 / No return value.
             */
            window.setTimeout(() => {
                if (root.dataset.homeTyping !== "true") return;
                root.removeAttribute("data-home-typing");
                document.querySelector("[data-hero]")?.classList.remove("is-typing");
                document.getElementById("hero-intro")?.classList.add("visible");
            }, 1400);
        }
    </script>
    <section class="hero" data-hero>
        <h1
            id="hero-greeting"
            class="hero-greeting"
            data-greeting={t("home.greeting")}
            aria-label={t("home.greeting")}
        >{t("home.greeting")}</h1>
        <p id="hero-intro" class="hero-intro">{t("home.intro")}</p>
    </section>

    <h2 class="section-title">{t("home.recent_posts")}</h2>
    <ul class="card-grid">
        {
            recentPosts.map((post) => (
                <li class="card">
                    <a href={`/${post.data.locale}/blog/${post.data.slug}/`}>
                        <p class="post-date">
                            {new Date(post.data.date).toLocaleDateString(lang)}
                        </p>
                        <h3 class="card-title">{post.data.title}</h3>
                        <p class="card-desc">{post.data.description ?? ""}</p>
                    </a>
                </li>
            ))
        }
    </ul>
</BaseLayout>

<script>
    /**
     * @brief 初始化首页打字动画 (typewriter animation) / Initialize the homepage typewriter animation.
     * @return 无返回值 / No return value.
     */
    document.addEventListener("DOMContentLoaded", () => {
        const heroEl = document.querySelector("[data-hero]");
        const greetingEl = document.getElementById("hero-greeting");
        const introEl = document.getElementById("hero-intro");
        const root = document.documentElement;

        // 如果找不到元素，就直接退出，避免报错
        if (
            !(heroEl instanceof HTMLElement) ||
            !(greetingEl instanceof HTMLElement) ||
            !(introEl instanceof HTMLElement)
        ) {
            root.removeAttribute("data-home-typing");
            return;
        }
        const greetingText = greetingEl.dataset.greeting;
        if (!greetingText) {
            root.removeAttribute("data-home-typing");
            return;
        }
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
            root.removeAttribute("data-home-typing");
            return;
        }

        heroEl.classList.add("is-typing");
        startTypewriter(greetingEl, introEl, greetingText);
    });

    /**
     * @brief 显示首页打字动画 (typewriter animation) / Render the homepage typewriter animation.
     * @param greetingEl 标题元素 (heading element) / Heading element.
     * @param introEl 简介元素 (intro element) / Introductory text element.
     * @param greetingText 显示文案 (greeting text) / Greeting text to display.
     * @return 无返回值 / No return value.
     */
    function startTypewriter(
        greetingEl: HTMLElement,
        introEl: HTMLElement,
        greetingText: string,
    ) {
        const typeStartDelayMs = 120;
        const typeIntervalMs = 32;
        const cursorDismissDelayMs = 480;
        const greetingCharacters = Array.from(greetingText);
        let i = 0;
        const cursor = document.createElement("span");
        cursor.className = "cursor";
        cursor.setAttribute("aria-hidden", "true");

        /**
         * @brief 渲染当前标题文本 (render greeting text) / Render the current greeting text.
         * @param text 标题文本 (greeting text) / Greeting text.
         * @return 无返回值 / No return value.
         */
        function renderGreeting(text: string) {
            greetingEl.replaceChildren(text, cursor);
        }

        /**
         * @brief 逐字更新标题 (type one character) / Type one character into the greeting.
         * @return 无返回值 / No return value.
         */
        function typeWriter() {
            if (i < greetingCharacters.length) {
                renderGreeting(greetingCharacters.slice(0, i + 1).join(""));
                i++;
                window.setTimeout(typeWriter, typeIntervalMs);
            } else {
                renderGreeting(greetingText);
                introEl.classList.add("visible");
                window.setTimeout(() => cursor.remove(), cursorDismissDelayMs);
            }
        }

        renderGreeting("");
        document.documentElement.removeAttribute("data-home-typing");
        window.setTimeout(typeWriter, typeStartDelayMs);
    }
</script>

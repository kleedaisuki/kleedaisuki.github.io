---
import { getCollection } from "astro:content";
import { useTranslations } from "@i18n/utils";
// src/pages/en/blog/index.astro
import BaseLayout from "@layouts/BaseLayout.astro";
import "@styles/blog.css";
import { createBlogJsonLd, getAbsoluteUrl } from "../../../lib/seo";

const lang = "en";
const t = useTranslations(lang);
const archiveDescription = t("blog.description");
const structuredData = createBlogJsonLd({
  url: getAbsoluteUrl(`/${lang}/blog/`),
  locale: lang,
  name: t("blog.title"),
  description: archiveDescription,
});

const posts = (await getCollection("blog"))
  .filter((p) => p.data.locale === lang && !p.data.draft)
  .sort(
    (a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf(),
  );
---

<BaseLayout
  pageTitle={`${t("blog.title")} | kleedaisuki`}
  description={archiveDescription}
  structuredData={structuredData}
>
  <div class="blog-container">
    <header class="blog-header">
      <h1 id="blog-archive-heading" class="blog-title">{t("blog.title")}</h1>
      <p class="blog-description">{archiveDescription}</p>
    </header>

    <section aria-labelledby="blog-archive-heading">
      <ul class="post-list">
        {
          posts.map((p) => (
            <li class="post-item">
              <div class="post-content">
                <div class="post-meta">
                  <time datetime={p.data.date.toISOString()}>
                    {new Date(p.data.date).toLocaleDateString(lang, {
                      year: "numeric",
                      month: "long",
                      day: "numeric",
                    })}
                  </time>
                </div>

                <h2 class="post-title">
                  <a href={`/${p.data.locale}/blog/${p.data.slug}/`}>{p.data.title}</a>
                </h2>

                {p.data.description && (
                  <p class="post-description">{p.data.description}</p>
                )}

                {p.data.tags && p.data.tags.length > 0 && (
                  <ul class="post-tags">
                    {p.data.tags.map((tag) => (
                      <li class="tag-item">{tag}</li>
                    ))}
                  </ul>
                )}
              </div>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</BaseLayout>

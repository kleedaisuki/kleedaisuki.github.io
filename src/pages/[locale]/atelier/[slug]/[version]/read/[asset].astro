---
import { getCollection } from "astro:content";
import PdfReader from "@components/atelier/PdfReader.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import {
  ATELIER_COPY,
  ATELIER_LOCALES,
  type AtelierLocale,
} from "@i18n/atelier";
import {
  getAtelierPath,
  getAtelierReleasePath,
  enrichAtelierFile,
  getFileCapability,
  getAtelierText,
  getLatestRelease,
  getReleaseFileUrl,
} from "../../../../../../lib/atelier";

/** @brief 阅读器静态路由属性 (reader static route properties). */
interface Props {
  title: string;
  version: string;
  pdfUrl: string;
  downloadName: string;
  backUrl: string;
  locale: AtelierLocale;
}

/** @brief 为全部已发布 PDF 生成稳定阅读路由 (Generate stable reader routes for every published PDF).
 * @return Astro 静态路径列表 (Astro static path list).
 */
export async function getStaticPaths() {
  const works = await getCollection("atelier", ({ data }) => !data.draft);

  const candidates = works.flatMap((work) =>
    work.data.releases.flatMap((release) =>
      release.files
        .filter((file) => getFileCapability(file).kind === "pdf")
        .map((file) => ({ work, release, file })),
    ),
  );

  const routes = await Promise.all(
    candidates.map(async ({ work, release, file }) => {
      const enrichedFile = await enrichAtelierFile(
        work.data.slug,
        release.version,
        file,
      );
      if (enrichedFile.available === false) return undefined;
      return ATELIER_LOCALES.map((locale) => ({
        params: {
          locale,
          slug: work.data.slug,
          version: release.version,
          asset: file.id,
        },
        props: {
          title: getAtelierText(work.data.title, locale),
          version: release.version,
          pdfUrl: getReleaseFileUrl(work.data.slug, release.version, file),
          downloadName: file.path.split("/").at(-1) ?? `${file.id}.pdf`,
          backUrl:
            release.version === getLatestRelease(work.data.releases)?.version
              ? getAtelierPath(locale, work.data.slug)
              : getAtelierReleasePath(locale, work.data.slug, release.version),
          locale,
        } satisfies Props,
      }));
    }),
  );
  return routes.flatMap((route) => route ?? []);
}

const { title, version, pdfUrl, downloadName, backUrl, locale } =
  Astro.props as Props;
/** @brief 当前阅读器文案 / Current localized reader copy. */
const copy = ATELIER_COPY[locale];
---

<BaseLayout
  pageTitle={`${title} — ${copy.pdfReader}`}
  description={locale === "zh"
    ? `在线阅读 ${title}，版本 ${version}。`
    : `Read ${title}, release ${version}, online.`}
  robots="noindex, follow"
  documentLocale={locale}
  layoutMode="reader"
>
  <PdfReader
    pdfUrl={pdfUrl}
    downloadName={downloadName}
    title={title}
    backUrl={backUrl}
    locale={locale}
  />
</BaseLayout>

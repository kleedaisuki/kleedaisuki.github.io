---
import { getCollection } from "astro:content";
import WorkCard from "@components/atelier/WorkCard.astro";
import Plate from "@components/pixel/Plate.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import "@styles/atelier.css";
import { ATELIER_COPY, ATELIER_LOCALES, asAtelierLocale } from "@i18n/atelier";
import {
  getAtelierActivityDate,
  getAtelierPath,
  getAtelierText,
  getFileCapability,
  getLatestRelease,
  scanSourceFiles,
} from "../../../lib/atelier";
import {
  createAtelierCollectionJsonLd,
  getAbsoluteUrl,
} from "../../../lib/seo";

/** @brief 生成两种语言的 Atelier 目录 / Generate the Atelier catalogue for both locales. */
export function getStaticPaths() {
  return ATELIER_LOCALES.map((locale) => ({ params: { locale } }));
}

/** @brief 当前 Atelier 页面语言 / Current Atelier page locale. */
const locale = asAtelierLocale(Astro.params.locale);
/** @brief 当前 Atelier 界面文案 / Current localized Atelier copy. */
const copy = ATELIER_COPY[locale];
/** @brief 当前 Atelier 目录路径 / Current localized Atelier catalogue path. */
const cataloguePath = `/${locale}/articrafts/`;

/** @brief Atelier 页面说明 / Atelier catalogue description. */
const description = copy.catalogueDescription;
/** @brief 公开作品，按最近活动时间排序 / Published works sorted by most recent activity. */
const works = (await getCollection("atelier", ({ data }) => !data.draft)).sort(
  (left, right) =>
    getAtelierActivityDate(
      right.data.published,
      right.data.updated,
      right.data.releases,
    ).getTime() -
    getAtelierActivityDate(
      left.data.published,
      left.data.updated,
      left.data.releases,
    ).getTime(),
);

/**
 * @brief 为筛选器推导文件类型标签 / Derive a filter label from a file.
 * @param file 发布文件 / Release file.
 * @return 面向读者的类型 / Reader-facing type label.
 */
function getTypeLabel(
  file: (typeof works)[number]["data"]["releases"][number]["files"][number],
): string {
  const path = file.path.toLocaleLowerCase();
  const mediaType = file.mediaType?.toLocaleLowerCase() ?? "";
  if (
    mediaType.includes("csv") ||
    mediaType.includes("json") ||
    /\.(?:csv|json|parquet|tsv)$/.test(path)
  ) {
    return copy.data;
  }
  const capability = getFileCapability(file);
  if (capability.kind === "pdf") return copy.papers;
  if (capability.kind === "source") return copy.source;
  if (capability.kind === "archive") return copy.archives;
  return copy.downloads;
}

/** @brief 每项作品的目录展示模型 / Catalogue presentation model for each work. */
const catalogueWorks = await Promise.all(
  works.map(async (work) => {
    const latest = getLatestRelease(work.data.releases);
    const types = new Set(latest?.files.map(getTypeLabel) ?? []);
    if (
      latest &&
      (await scanSourceFiles(work.data.slug, latest.version)).length > 0
    ) {
      types.add(copy.source);
    }
    return { work, types: [...types] };
  }),
);
/** @brief 动态文件类型筛选项 / Dynamic file-type filters. */
const typeFilters = [
  ...new Set(catalogueWorks.flatMap(({ types }) => types)),
].sort();
/** @brief Atelier 目录结构化数据 / Structured data for the Atelier catalogue. */
const structuredData = createAtelierCollectionJsonLd({
  url: getAbsoluteUrl(cataloguePath),
  locale,
  name: "Articrafts",
  description,
  items: works.map((work) => ({
    url: getAbsoluteUrl(getAtelierPath(locale, work.data.slug)),
    name: getAtelierText(work.data.title, locale),
    description: getAtelierText(work.data.summary, locale),
  })),
});
---

<BaseLayout
  pageTitle="Articrafts | Atelier"
  description={description}
  structuredData={structuredData}
  documentLocale={locale}
>
  <div
    class="page atelier-catalogue"
    data-atelier-catalogue
    data-showing-all={locale === "zh" ? "共展示 {count} 件作品。" : "Showing all {count} {noun}."}
    data-showing-some={locale === "zh" ? "展示 {visible}/{total} 件作品。" : "Showing {visible} of {total} works."}
  >
    <header class="page-intro">
      <h1>{copy.atelier}</h1>
      <Plate seed="articrafts" />
    </header>

    {
      works.length > 0 ? (
        <>
          {typeFilters.length > 1 && (
            <nav class="atelier-toolbar pad" aria-label={copy.filterWorks}>
              <div class="moe-segmented slider" data-filter-group="type">
                <a class="moe-segmented__option" href={cataloguePath} data-filter-value="" aria-current="true">{copy.allTypes}</a>
                {typeFilters.map((type) => (
                  <a class="moe-segmented__option" href={`?type=${encodeURIComponent(type.toLocaleLowerCase())}`} data-filter-value={type.toLocaleLowerCase()}>
                    {type}
                  </a>
                ))}
              </div>
            </nav>
          )}
          <p class="moe-visually-hidden" role="status" aria-live="polite" data-results-status></p>
          <div class="atelier-grid" data-work-grid>
            {catalogueWorks.map(({ work, types }) => (
              <WorkCard
                slug={work.data.slug}
                locale={locale}
                title={getAtelierText(work.data.title, locale)}
                summary={getAtelierText(work.data.summary, locale)}
                activityDate={getAtelierActivityDate(
                  work.data.published,
                  work.data.updated,
                  work.data.releases,
                )}
                cover={work.data.cover}
                types={types}
              />
            ))}
          </div>
          <section class="atelier-empty moe-empty" data-no-results hidden>
            <h2 class="moe-empty__title">{copy.noMatch}</h2>
            <a class="moe-button moe-button--secondary" href={cataloguePath} data-clear-filters>{copy.clearFilters}</a>
          </section>
        </>
      ) : (
        <section class="atelier-empty moe-empty">
          <h2 class="moe-empty__title">{copy.emptyTitle}</h2>
          <a class="moe-button" href={`/${locale}/`}>{copy.visitBlog}</a>
        </section>
      )
    }
  </div>

  <script>
    /** @brief 可由 URL 恢复的目录筛选状态 / Catalogue filter state restorable from the URL. */
    interface FilterState {
      type: string;
    }

    /** @brief Atelier 目录根节点 / Atelier catalogue root. */
    const catalogue = document.querySelector<HTMLElement>("[data-atelier-catalogue]");

    if (catalogue) {
      catalogue.classList.add("atelier-catalogue--enhanced");

      /** @brief 作品卡片集合 / Work-card collection. */
      const cards = [...catalogue.querySelectorAll<HTMLElement>("[data-work-card]")];
      /** @brief 无匹配结果区域 / No-match result panel. */
      const noResults = catalogue.querySelector<HTMLElement>("[data-no-results]");
      /** @brief 结果数量播报区域 / Result-count live region. */
      const status = catalogue.querySelector<HTMLElement>("[data-results-status]");

      /**
       * @brief 从地址读取当前筛选 / Read the current filters from the address.
       * @return 规范化筛选状态 / Normalized filter state.
       */
      const readState = (): FilterState => {
        const params = new URLSearchParams(window.location.search);
        return {
          type: params.get("type")?.toLocaleLowerCase() ?? "",
        };
      };

      /**
       * @brief 解析卡片的 JSON 数据列表 / Parse a card's JSON data list.
       * @param card 作品卡片 / Work card.
       * @return 规范化字符串列表 / Normalized string list.
       */
      const readTypes = (card: HTMLElement): string[] => {
        try {
          return JSON.parse(card.dataset.types ?? "[]");
        } catch {
          return [];
        }
      };

      /**
       * @brief 应用筛选并同步控件状态 / Apply filters and synchronize controls.
       * @param state 筛选状态 / Filter state.
       */
      const applyFilters = (state: FilterState, announce = true): void => {
        let visibleCount = 0;
        for (const card of cards) {
          const typeMatch = !state.type || readTypes(card).includes(state.type);
          card.hidden = !typeMatch;
          if (!card.hidden) visibleCount += 1;
        }

        for (const group of catalogue.querySelectorAll<HTMLElement>("[data-filter-group]")) {
          const key = group.dataset.filterGroup as keyof FilterState;
          for (const link of group.querySelectorAll<HTMLAnchorElement>("[data-filter-value]")) {
            if ((link.dataset.filterValue ?? "") === state[key]) {
              link.setAttribute("aria-current", "true");
            } else {
              link.removeAttribute("aria-current");
            }
          }
        }

        if (noResults) noResults.hidden = visibleCount !== 0;
        if (status && announce) {
          const showingAll = catalogue.dataset.showingAll ?? "Showing all {count} {noun}.";
          const showingSome = catalogue.dataset.showingSome ?? "Showing {visible} of {total} works.";
          status.textContent = visibleCount === cards.length
            ? showingAll
                .replace("{count}", String(visibleCount))
                .replace("{noun}", visibleCount === 1 ? "work" : "works")
            : showingSome
                .replace("{visible}", String(visibleCount))
                .replace("{total}", String(cards.length));
        }
      };

      /**
       * @brief 写入可分享的筛选地址 / Write a shareable filter URL.
       * @param state 筛选状态 / Filter state.
       */
      const writeState = (state: FilterState): void => {
        const params = new URLSearchParams();
        if (state.type) params.set("type", state.type);
        const query = params.toString();
        history.pushState(null, "", `${window.location.pathname}${query ? `?${query}` : ""}`);
        applyFilters(state);
      };

      for (const group of catalogue.querySelectorAll<HTMLElement>("[data-filter-group]")) {
        const key = group.dataset.filterGroup as keyof FilterState;
        group.addEventListener("click", (event) => {
          const link = (event.target as Element).closest<HTMLAnchorElement>("[data-filter-value]");
          if (!link) return;
          event.preventDefault();
          const state = readState();
          state[key] = link.dataset.filterValue ?? "";
          writeState(state);
        });
      }

      catalogue.querySelector("[data-clear-filters]")?.addEventListener("click", (event) => {
        event.preventDefault();
        writeState({ type: "" });
      });
      window.addEventListener("popstate", () => applyFilters(readState()));
      applyFilters(readState(), false);
    }
  </script>
</BaseLayout>

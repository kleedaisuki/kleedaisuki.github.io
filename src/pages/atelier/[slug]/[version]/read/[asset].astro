---
import { getCollection } from "astro:content";
import PdfReader from "@components/atelier/PdfReader.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import {
  getAtelierPath,
  getAtelierReleasePath,
  enrichAtelierFile,
  getFileCapability,
  getLatestRelease,
  getReleaseFileUrl,
} from "../../../../../lib/atelier";

/** @brief 阅读器静态路由属性 (reader static route properties). */
interface Props {
  title: string;
  version: string;
  pdfUrl: string;
  downloadName: string;
  backUrl: string;
}

/** @brief 为全部已发布 PDF 生成稳定阅读路由 (Generate stable reader routes for every published PDF).
 * @return Astro 静态路径列表 (Astro static path list).
 */
export async function getStaticPaths() {
  const works = await getCollection("atelier", ({ data }) => !data.draft);

  const candidates = works.flatMap((work) =>
    work.data.releases.flatMap((release) =>
      release.files
        .filter((file) => getFileCapability(file).kind === "pdf")
        .map((file) => ({ work, release, file })),
    ),
  );

  const routes = await Promise.all(
    candidates.map(async ({ work, release, file }) => {
      const enrichedFile = await enrichAtelierFile(
        work.data.slug,
        release.version,
        file,
      );
      if (enrichedFile.available === false) return undefined;
      return {
        params: {
          slug: work.data.slug,
          version: release.version,
          asset: file.id,
        },
        props: {
          title: work.data.title,
          version: release.version,
          pdfUrl: getReleaseFileUrl(work.data.slug, release.version, file),
          downloadName: file.path.split("/").at(-1) ?? `${file.id}.pdf`,
          backUrl:
            release.version === getLatestRelease(work.data.releases)?.version
              ? getAtelierPath(work.data.slug)
              : getAtelierReleasePath(work.data.slug, release.version),
        } satisfies Props,
      };
    }),
  );
  return routes.filter((route) => route !== undefined);
}

const { title, version, pdfUrl, downloadName, backUrl } = Astro.props;
---

<BaseLayout
  pageTitle={`${title} — PDF Reader`}
  description={`Read ${title}, release ${version}, online.`}
  robots="noindex, follow"
  standalone
  documentLocale="en"
  showLanguageSwitch={false}
>
  <PdfReader
    pdfUrl={pdfUrl}
    downloadName={downloadName}
    title={title}
    version={version}
    backUrl={backUrl}
  />
</BaseLayout>

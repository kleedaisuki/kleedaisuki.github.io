---
/** @brief 旧 Atelier 根路径只负责选择语言 / Legacy Atelier root only selects a locale. */
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>Redirecting to Klee’s Atelier…</title>
    <script is:inline>
      (() => {
        let locale = "zh";
        try {
          locale = localStorage.getItem("prefLocale") === "en" ? "en" : "zh";
        } catch {
          locale = navigator.language.toLowerCase().startsWith("en") ? "en" : "zh";
        }
        location.replace(`/${locale}/atelier/`);
      })();
    </script>
    <noscript><meta http-equiv="refresh" content="0; url=/zh/atelier/" /></noscript>
  </head>
  <body>
    <noscript>
      <p>
        请选择语言 / Choose your language:
        <a href="/zh/atelier/">中文</a> |
        <a href="/en/atelier/">English</a>
      </p>
    </noscript>
  </body>
</html>

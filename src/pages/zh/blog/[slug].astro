---
import Base from "@layouts/BaseLayout.astro";
import "@styles/blog.css";
import { type CollectionEntry, getCollection, render } from "astro:content";
import { t } from "@i18n/t";
import {
  createBlogPostingJsonLd,
  getAbsoluteUrl,
  getPostPath,
} from "../../../lib/seo";

export async function getStaticPaths() {
  const all = await getCollection(
    "blog",
    (p) => p.data.locale === "zh" && !p.data.draft,
  );
  return all.map((p) => ({ params: { slug: p.data.slug } }));
}

const { slug } = Astro.params as { slug?: string };
if (!slug) throw new Error("Missing slug");

const entry = (await getCollection("blog")).find(
  (p): p is CollectionEntry<"blog"> =>
    p.data.locale === "zh" && !p.data.draft && p.data.slug === slug,
);
if (!entry) throw new Error(`[zh] Post not found: ${slug}`);

const { Content } = await render(entry);
const lang = "zh";
const archivePath = `/${lang}/blog/`;
const articlePath = getPostPath(lang, entry.data.slug);
const articleUrl = getAbsoluteUrl(articlePath);
const archiveUrl = getAbsoluteUrl(archivePath);
const formattedDate = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "long",
  day: "numeric",
}).format(entry.data.date);
const formattedUpdatedDate = entry.data.updated
  ? new Intl.DateTimeFormat("zh-CN", {
      year: "numeric",
      month: "long",
      day: "numeric",
    }).format(entry.data.updated)
  : undefined;
const structuredData = createBlogPostingJsonLd({
  url: articleUrl,
  archiveUrl,
  locale: lang,
  title: entry.data.title,
  description: entry.data.description,
  publishedAt: entry.data.date,
  modifiedAt: entry.data.updated,
  tags: entry.data.tags,
  homeName: t("home", lang),
  archiveName: t("blog", lang),
});
---

<Base
  pageTitle={`${entry.data.title} | kleedaisuki`}
  description={entry.data.description}
  pageType="article"
  publishedTime={entry.data.date.toISOString()}
  modifiedTime={entry.data.updated?.toISOString()}
  tags={entry.data.tags}
  structuredData={structuredData}
>
  <div class="post-body">
    <nav class="post-breadcrumb" aria-label="面包屑导航">
      <ol>
        <li><a href={`/${lang}/`}>{t("home", lang)}</a></li>
        <li><a href={archivePath}>{t("blog", lang)}</a></li>
        <li aria-current="page">{entry.data.title}</li>
      </ol>
    </nav>
    <header class="post-header">
      <h1 id="post-title">{entry.data.title}</h1>
      <p class="post-summary">{entry.data.description}</p>
      <p class="post-byline">
        <time datetime={entry.data.date.toISOString()}>发布于 {formattedDate}</time>
        <span aria-hidden="true"> · </span>
        <span>作者 <a href={`/${lang}/about/`}>kleedaisuki</a></span>
        {
          formattedUpdatedDate && entry.data.updated && (
            <>
              <span aria-hidden="true"> · </span>
              <time datetime={entry.data.updated.toISOString()}>
                更新于 {formattedUpdatedDate}
              </time>
            </>
          )
        }
      </p>
      {
        entry.data.tags && entry.data.tags.length > 0 && (
          <ul class="post-taxonomy" aria-label="文章标签">
            {entry.data.tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        )
      }
    </header>
    <article class="prose" aria-labelledby="post-title"><Content /></article>
  </div>
</Base>

---
// src/pages/zh/index.astro
import BaseLayout from "@layouts/BaseLayout.astro";
import { useTranslations } from "@i18n/utils";
import "@styles/home.css";
import { getCollection } from "astro:content";
import { createWebSiteJsonLd } from "../../lib/seo";

const lang = "zh";
const t = useTranslations(lang);
const pageTitle = "kleedaisuki | 编程、数学与思考笔记";
const structuredData = createWebSiteJsonLd(lang);

const posts = await getCollection(
  "blog",
  ({ data }) => data.locale === lang && !data.draft,
);
const sortedPosts = posts.sort(
  (a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf(),
);
const recentPosts = sortedPosts.slice(0, 3);
---

<BaseLayout
    pageTitle={pageTitle}
    description={t("home.intro")}
    structuredData={structuredData}
>
    <section class="hero" data-hero>
        <h1
            id="hero-greeting"
            class="hero-greeting"
            data-greeting={t("home.greeting")}
        >{t("home.greeting")}</h1>
        <p id="hero-intro" class="hero-intro">{t("home.intro")}</p>
    </section>

    <h2 class="section-title">{t("home.recent_posts")}</h2>
    <ul class="card-grid">
        {
            recentPosts.map((post) => (
                <li class="card">
                    <a href={`/${post.data.locale}/blog/${post.data.slug}/`}>
                        <p class="post-date">
                            {new Date(post.data.date).toLocaleDateString(lang)}
                        </p>
                        <h3 class="card-title">{post.data.title}</h3>
                        <p class="card-desc">{post.data.description ?? ""}</p>
                    </a>
                </li>
            ))
        }
    </ul>
</BaseLayout>

<script>
    // 这是一个在页面加载后执行的客户端脚本
    document.addEventListener("DOMContentLoaded", () => {
        const heroEl = document.querySelector("[data-hero]");
        const greetingEl = document.getElementById("hero-greeting");
        const introEl = document.getElementById("hero-intro");

        // 如果找不到元素，就直接退出，避免报错
        if (
            !(heroEl instanceof HTMLElement) ||
            !(greetingEl instanceof HTMLElement) ||
            !(introEl instanceof HTMLElement)
        ) {
            return;
        }
        const greetingText = greetingEl.dataset.greeting;
        if (!greetingText) return;
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

        heroEl.classList.add("is-typing");
        startTypewriter(greetingEl, introEl, greetingText);
    });

    /**
     * @brief 显示首页打字动画 (typewriter animation) / Render the homepage typewriter animation.
     * @param greetingEl 标题元素 (heading element) / Heading element.
     * @param introEl 简介元素 (intro element) / Introductory text element.
     * @param greetingText 显示文案 (greeting text) / Greeting text to display.
     * @return 无返回值 / No return value.
     */
    function startTypewriter(
        greetingEl: HTMLElement,
        introEl: HTMLElement,
        greetingText: string,
    ) {
        let i = 0;
        const cursor = document.createElement("span");
        cursor.className = "cursor";
        cursor.setAttribute("aria-hidden", "true");

        function renderGreeting(text: string) {
            greetingEl.textContent = text;
            greetingEl.append(cursor);
        }

        function typeWriter() {
            if (i < greetingText.length) {
                renderGreeting(greetingText.substring(0, i + 1));
                i++;
                setTimeout(typeWriter, Math.random() * 150 + 50);
            } else {
                renderGreeting(greetingText);
                introEl.classList.add("visible");
            }
        }

        setTimeout(typeWriter, 500);
    }
</script>

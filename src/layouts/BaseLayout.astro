---
import "@styles/global.css"; // 我们把 global.css 的引用放在这里
import "@styles/fonts.css";
import Nav from "@components/Nav.astro";
import LangSwitch from "@components/LangSwitch.astro";
import { getAbsoluteLocaleUrl } from "astro:i18n";
import { getCollection } from "astro:content";
import { getPairedSlug } from "../lib/localized-blog";

const pathname = Astro.url.pathname;
const strip = pathname.replace(/^\/(zh|en)\//, "");
const m = pathname.match(/^\/(zh|en)\/blog\/([^/]+)\/?$/);

let alternates = (["zh", "en"] as const).map((loc) => ({
  locale: loc,
  url: getAbsoluteLocaleUrl(loc, strip),
}));

if (m) {
  const currentLocale = m[1] as "zh" | "en";
  const currentSlug = decodeURIComponent(m[2]);
  const allPosts = await getCollection("blog", ({ data }) => !data.draft);
  const currentPost = allPosts.find(
    (post) =>
      post.data.locale === currentLocale && post.data.slug === currentSlug,
  );
  if (currentPost) {
    const zhSlug = getPairedSlug(allPosts, currentLocale, currentSlug, "zh");
    const enSlug = getPairedSlug(allPosts, currentLocale, currentSlug, "en");

    alternates = [
      {
        locale: "zh",
        url: zhSlug
          ? getAbsoluteLocaleUrl("zh", `blog/${encodeURIComponent(zhSlug)}/`)
          : getAbsoluteLocaleUrl("zh", strip),
      },
      {
        locale: "en",
        url: enSlug
          ? getAbsoluteLocaleUrl("en", `blog/${encodeURIComponent(enSlug)}/`)
          : getAbsoluteLocaleUrl("en", strip),
      },
    ];
  }
}

const canonical = new URL(
  Astro.url.pathname,
  Astro.site ?? "https://blog.moesegfault.dev",
).toString();
const { pageTitle } = Astro.props as { pageTitle?: string };
---

<html lang={Astro.currentLocale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#5b3cc4" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    {
      alternates.map((a) => (
        <link rel="alternate" hreflang={a.locale} href={a.url} />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={getAbsoluteLocaleUrl("zh", "")}
    />
    <title>{pageTitle ?? "kleedaisuki"}</title>
  </head>
  <body>
    <div class="site-wrapper">
      <header class="container">
        <Nav />
        <LangSwitch />
      </header>
      <main class="container">
        <slot />
      </main>
      <footer class="container">
        © 2024-{new Date().getFullYear()} kleedaisuki ✨<br />
        <a
          href="http://creativecommons.org/licenses/by-nc-sa/4.0/"
          rel="license"
        >
          CC BY-NC-SA 4.0
        </a>
      </footer>
    </div>
  </body>
</html>

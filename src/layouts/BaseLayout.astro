---
import "@styles/global.css"; // 我们把 global.css 的引用放在这里
import "@styles/fonts.css";
import Nav from "@components/Nav.astro";
import LangSwitch from "@components/LangSwitch.astro";
import { getAbsoluteLocaleUrl } from "astro:i18n";
import { getCollection } from "astro:content";
import { getPublishedAlternates, type BlogLocale } from "../lib/localized-blog";
import {
  getOpenGraphLocale,
  serializeJsonLd,
  SITE,
  type JsonLdObject,
} from "../lib/seo";

/** @brief 页面布局的 SEO 属性 (layout SEO props) / SEO properties accepted by the base layout. */
interface LayoutProps {
  pageTitle?: string;
  description?: string;
  pageType?: "website" | "article";
  publishedTime?: string;
  modifiedTime?: string;
  tags?: string[];
  structuredData?: JsonLdObject;
  robots?: string;
}

const pathname = Astro.url.pathname;
const strip = pathname.replace(/^\/(zh|en)\//, "");
const m = pathname.match(/^\/(zh|en)\/blog\/([^/]+)\/?$/);
const currentLocale: BlogLocale = Astro.currentLocale === "en" ? "en" : "zh";

let alternates = (["zh", "en"] as const).map((loc) => ({
  locale: loc,
  url: getAbsoluteLocaleUrl(loc, strip),
}));
let xDefaultUrl = alternates.find(
  (alternate) => alternate.locale === "zh",
)?.url;

if (m) {
  const postLocale = m[1] as BlogLocale;
  const currentSlug = decodeURIComponent(m[2]);
  const allPosts = await getCollection("blog", ({ data }) => !data.draft);
  const publishedAlternates = getPublishedAlternates(
    allPosts,
    postLocale,
    currentSlug,
  );
  alternates = publishedAlternates.map((alternate) => ({
    locale: alternate.locale,
    url: getAbsoluteLocaleUrl(
      alternate.locale,
      `blog/${encodeURIComponent(alternate.slug)}/`,
    ),
  }));
  xDefaultUrl = alternates.find((alternate) => alternate.locale === "zh")?.url;
}

const canonical = new URL(
  Astro.url.pathname,
  Astro.site ?? "https://blog.moesegfault.dev",
).toString();
const {
  pageTitle = SITE.name,
  description = SITE.defaultDescription[currentLocale],
  pageType = "website",
  publishedTime,
  modifiedTime,
  tags = [],
  structuredData,
  robots,
} = Astro.props as LayoutProps;
const rssPath = currentLocale === "zh" ? "/zh/rss.xml" : "/en/rss.xml";
const rssTitle =
  currentLocale === "zh" ? "kleedaisuki 中文 RSS" : "kleedaisuki English RSS";
const alternateOpenGraphLocales = alternates
  .filter((alternate) => alternate.locale !== currentLocale)
  .map((alternate) => getOpenGraphLocale(alternate.locale));
---

<html lang={currentLocale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#5b3cc4" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <meta property="og:type" content={pageType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={getOpenGraphLocale(currentLocale)} />
    {
      alternateOpenGraphLocales.map((locale) => (
        <meta property="og:locale:alternate" content={locale} />
      ))
    }
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={rssTitle}
      href={rssPath}
    />
    {
      alternates.map((a) => (
        <link rel="alternate" hreflang={a.locale} href={a.url} />
      ))
    }
    {xDefaultUrl && <link rel="alternate" hreflang="x-default" href={xDefaultUrl} />}
    {
      pageType === "article" && publishedTime && (
        <meta property="article:published_time" content={publishedTime} />
      )
    }
    {
      pageType === "article" && modifiedTime && (
        <meta property="article:modified_time" content={modifiedTime} />
      )
    }
    {pageType === "article" && <meta property="article:author" content={SITE.authorUrl} />}
    {
      pageType === "article" &&
        tags.map((tag) => <meta property="article:tag" content={tag} />)
    }
    {structuredData && (
      <script
        is:inline
        type="application/ld+json"
        set:html={serializeJsonLd(structuredData)}
      />
    )}
    <title>{pageTitle}</title>
  </head>
  <body>
    <div class="site-wrapper">
      <header class="container">
        <Nav />
        <LangSwitch />
      </header>
      <main class="container">
        <slot />
      </main>
      <footer class="container">
        © 2024-{new Date().getFullYear()} kleedaisuki ✨<br />
        <a
          href="http://creativecommons.org/licenses/by-nc-sa/4.0/"
          rel="license"
        >
          CC BY-NC-SA 4.0
        </a>
      </footer>
    </div>
  </body>
</html>

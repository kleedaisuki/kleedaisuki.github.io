---
import "@styles/global.css";
import "@styles/fonts.css";
import { getCollection } from "astro:content";
import { getAbsoluteLocaleUrl } from "astro:i18n";
import LangSwitch from "@components/LangSwitch.astro";
import Nav from "@components/Nav.astro";
import { type BlogLocale, getPublishedAlternates } from "../lib/localized-blog";
import {
  getOpenGraphLocale,
  type JsonLdObject,
  SITE,
  serializeJsonLd,
} from "../lib/seo";

/** @brief 页面布局的 SEO 属性 (layout SEO props) / SEO properties accepted by the base layout. */
interface LayoutProps {
  pageTitle?: string;
  description?: string;
  pageType?: "website" | "article";
  publishedTime?: string;
  modifiedTime?: string;
  tags?: string[];
  structuredData?: JsonLdObject;
  robots?: string;
  /** @brief 是否显示语言切换导航 (whether to render the language switcher). */
  showLanguageSwitch?: boolean;
  /** @brief 文档内容语言；无语言路由页面必须显式提供 (document content locale for pages outside locale routing). */
  documentLocale?: BlogLocale;
  /** @brief 页面是否属于无语言分区的独立内容域 (whether the page belongs to a locale-independent standalone area). */
  standalone?: boolean;
  /** @brief 可选的规范 URL 覆盖 (optional canonical URL override). */
  canonicalPath?: string;
  /** @brief 页面布局模式；阅读器在移动端使用沉浸式视口 (page layout mode; readers use an immersive mobile viewport). */
  layoutMode?: "default" | "reader";
}

const pathname = Astro.url.pathname;
const strip = pathname.replace(/^\/(zh|en)\//, "");
const m = pathname.match(/^\/(zh|en)\/blog\/([^/]+)\/?$/);
const siteLocale: BlogLocale = Astro.currentLocale === "en" ? "en" : "zh";

let alternates = (["zh", "en"] as const).map((loc) => ({
  locale: loc,
  url: getAbsoluteLocaleUrl(loc, strip),
}));
let xDefaultUrl = alternates.find(
  (alternate) => alternate.locale === "zh",
)?.url;

if (m) {
  const postLocale = m[1] as BlogLocale;
  const currentSlug = decodeURIComponent(m[2]);
  const allPosts = await getCollection("blog", ({ data }) => !data.draft);
  const publishedAlternates = getPublishedAlternates(
    allPosts,
    postLocale,
    currentSlug,
  );
  alternates = publishedAlternates.map((alternate) => ({
    locale: alternate.locale,
    url: getAbsoluteLocaleUrl(
      alternate.locale,
      `blog/${encodeURIComponent(alternate.slug)}/`,
    ),
  }));
  xDefaultUrl = alternates.find((alternate) => alternate.locale === "zh")?.url;
}

const {
  pageTitle = SITE.name,
  description = SITE.defaultDescription[siteLocale],
  pageType = "website",
  publishedTime,
  modifiedTime,
  tags = [],
  structuredData,
  robots,
  showLanguageSwitch = true,
  documentLocale = siteLocale,
  standalone = false,
  canonicalPath,
  layoutMode = "default",
} = Astro.props as LayoutProps;
const canonical = new URL(
  canonicalPath ?? Astro.url.pathname,
  Astro.site ?? SITE.url,
).toString();
/** @brief 页面是否显式脱离站点国际化路由 / Whether the page explicitly opts out of site locale routing. */
const isLocaleIndependent = standalone;
const effectiveShowLanguageSwitch = showLanguageSwitch && !isLocaleIndependent;
const rssPath = siteLocale === "zh" ? "/zh/rss.xml" : "/en/rss.xml";
const rssTitle =
  siteLocale === "zh" ? "kleedaisuki 中文 RSS" : "kleedaisuki English RSS";
const alternateOpenGraphLocales = alternates
  .filter((alternate) => alternate.locale !== siteLocale)
  .map((alternate) => getOpenGraphLocale(alternate.locale));
---

<html lang={documentLocale}>
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="color-scheme" content="light dark" />
    <meta id="theme-color" name="theme-color" content="#fff6ea" />
    <script is:inline>
      /**
       * @brief 在首次绘制前恢复站点主题 (Restore theme before first paint).
       * @note 主题仅保存在浏览器本地，系统偏好用作首次访问的回退值。
       */
      (() => {
        const storageKey = "site-theme";
        const root = document.documentElement;
        let savedTheme = null;

        try {
          savedTheme = localStorage.getItem(storageKey);
        } catch {
          // 隐私模式或受限环境下退回系统主题 (Fall back when storage is unavailable).
        }

        const theme =
          savedTheme === "light" || savedTheme === "dark"
            ? savedTheme
            : window.matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light";

        root.dataset.theme = theme;
        root.style.colorScheme = theme;
        document
          .querySelector('meta[name="theme-color"]')
          ?.setAttribute("content", theme === "dark" ? "#21130f" : "#fff6ea");
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <meta property="og:type" content={pageType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={getOpenGraphLocale(documentLocale)} />
    {
      !isLocaleIndependent && alternateOpenGraphLocales.map((locale) => (
        <meta property="og:locale:alternate" content={locale} />
      ))
    }
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {
      !isLocaleIndependent && (
        <link
          rel="alternate"
          type="application/rss+xml"
          title={rssTitle}
          href={rssPath}
        />
      )
    }
    {
      !isLocaleIndependent && alternates.map((a) => (
        <link rel="alternate" hreflang={a.locale} href={a.url} />
      ))
    }
    {!isLocaleIndependent && xDefaultUrl && <link rel="alternate" hreflang="x-default" href={xDefaultUrl} />}
    {
      pageType === "article" && publishedTime && (
        <meta property="article:published_time" content={publishedTime} />
      )
    }
    {
      pageType === "article" && modifiedTime && (
        <meta property="article:modified_time" content={modifiedTime} />
      )
    }
    {pageType === "article" && <meta property="article:author" content={SITE.authorUrl} />}
    {
      pageType === "article" &&
        tags.map((tag) => <meta property="article:tag" content={tag} />)
    }
    {structuredData && (
      <script
        is:inline
        type="application/ld+json"
        set:html={serializeJsonLd(structuredData)}
      />
    )}
    <title>{pageTitle}</title>
  </head>
  <body class:list={{ "layout-reader": layoutMode === "reader" }}>
    <a class="skip-link" href="#main-content">
      {documentLocale === "zh" ? "跳至正文" : "Skip to content"}
    </a>
    <div class="site-wrapper">
      <header class="container workshop-header">
        <Nav locale={documentLocale} />
        {effectiveShowLanguageSwitch && <LangSwitch />}
      </header>
      <main id="main-content" class="container" tabindex="-1">
        <slot />
      </main>
      <footer class="container workshop-footer">
        <p class="workshop-footer__mark" aria-hidden="true">
          ATELIER / COLOPHON
        </p>
        <p>
          <span>© 2024-{new Date().getFullYear()} kleedaisuki</span>
          <span aria-hidden="true"> · </span>
          <a
            href="http://creativecommons.org/licenses/by-nc-sa/4.0/"
            rel="license"
          >
            CC BY-NC-SA 4.0
          </a>
        </p>
      </footer>
    </div>
  </body>
</html>

---
import Hearth from "@components/pixel/Hearth.astro";
import type { Locale } from "@i18n/t";
import { defaultLang } from "@i18n/ui";
import { useTranslations } from "@i18n/utils";
import BaseLayout from "@layouts/BaseLayout.astro";
import { crestFuel } from "../lib/pixel/hearth";
import { strokeRun, tonePaths } from "../lib/pixel/raster";
import { pixelNumber, placed } from "../lib/pixel/type";

interface Props {
  lang?: Locale;
  showBoth?: boolean;
}
const { lang = defaultLang, showBoth = false } = Astro.props;
const locales: Locale[] = showBoth ? ["zh", "en"] : [lang];
const panels = locales.map((locale) => ({
  locale,
  t: useTranslations(locale),
}));

const COLUMNS = 84;
const ROWS = 76;
const SCALE = 4;
const digits = pixelNumber(404);
const lit = placed(digits, {
  left: (COLUMNS - digits.columns * SCALE) / 2,
  top: ROWS - (digits.rows + 2) * SCALE,
  scale: SCALE,
});
const [ink] = tonePaths(COLUMNS, ROWS, (column, row) =>
  lit(column, row) ? "ink" : undefined,
);
---

<BaseLayout
  pageTitle={showBoth ? "404 Not Found / 页面未找到" : panels[0].t("404.title")}
  robots="noindex,follow"
  showLanguageSwitch={!showBoth}
>
  <div class="page not-found">
    <section class="bleed" data-moe-surface="brand" data-hearth-field>
      <div class="not-found__inner framed pad">
        <div class="not-found__copy">
          <h1>{panels.map(({ locale, t }) => <span lang={locale}>{t("404.title")}</span>)}</h1>
          <div class="moe-cluster">
            {
              panels.map(({ locale, t }, index) => (
                <a class:list={["moe-button moe-button--lg", index > 0 && "moe-button--secondary"]} href={`/${locale}/`} lang={locale}>{t("404.link.home")}</a>
              ))
            }
          </div>
        </div>
        <Hearth columns={COLUMNS} rows={ROWS} fuel={crestFuel(lit, COLUMNS, ROWS)}>
          <svg class="not-found__digits" viewBox={`0 0 ${COLUMNS} ${ROWS}`} focusable="false">
            <path d={ink?.d} transform="translate(0.07 0.5)" fill="none" stroke="currentColor" {...strokeRun} />
          </svg>
        </Hearth>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .not-found {
    height: 100%;
  }
  .not-found > section {
    display: grid;
    min-height: max(34rem, calc(100vh - var(--site-header) - 4.5rem));
    isolation: isolate;
    overflow: clip;
    touch-action: pan-y;
  }
  .not-found__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    align-items: center;
    gap: var(--moe-space-6);
  }
  .not-found__copy {
    display: grid;
    justify-items: start;
    gap: var(--moe-space-5);
  }
  .not-found h1 {
    display: grid;
    gap: 0.2em;
    margin: 0;
    font-size: clamp(2.25rem, 4.4vw, 3.75rem);
    letter-spacing: -0.04em;
    line-height: 1.12;
  }
  .not-found h1 :lang(zh) {
    letter-spacing: -0.01em;
  }
  .not-found :global(.hearth) {
    z-index: -1;
    align-self: end;
    aspect-ratio: 84 / 76;
  }
  .not-found__digits {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  @media (max-width: 46rem) {
    .not-found__inner {
      grid-template-columns: minmax(0, 1fr);
      padding-block-start: var(--moe-space-7);
    }
    .not-found :global(.hearth) {
      margin-block-start: -5rem;
    }
  }
</style>

---
import BaseLayout from "@layouts/BaseLayout.astro";
import { defaultLang, languages } from "@i18n/ui";
import { useTranslations } from "@i18n/utils";

type Locale = "zh" | "en";
type Panel = {
  code: Locale;
  label: string;
  href: string;
  translate: ReturnType<typeof useTranslations>;
};

const { lang = defaultLang, showBoth = false } = Astro.props as {
  lang?: Locale;
  showBoth?: boolean;
};

const zh = useTranslations("zh");
const en = useTranslations("en");

const panels: Panel[] = showBoth
  ? [
      { code: "zh", label: languages.zh, href: "/zh/", translate: zh },
      { code: "en", label: languages.en, href: "/en/", translate: en },
    ]
  : [
      {
        code: lang,
        label: languages[lang],
        href: lang === "zh" ? "/zh/" : "/en/",
        translate: lang === "zh" ? zh : en,
      },
    ];

const active = panels[0].translate;
const pageTitle = showBoth ? "404 Not Found / 页面未找到" : active("404.title");
const heroTitle = active("404.title");
const heroSubtitle = showBoth
  ? "Choose a language below and hop back home."
  : active("404.message");
---

<BaseLayout
    pageTitle={pageTitle}
    robots="noindex,follow"
    showLanguageSwitch={!showBoth}
>
    <section class="not-found-shell">
        <div class="not-found-glow not-found-glow-left" aria-hidden="true"></div>
        <div class="not-found-glow not-found-glow-right" aria-hidden="true"></div>

        <div class="not-found-frame">
            <header class="not-found-hero">
                <p class="not-found-kicker">404</p>
                {
                    showBoth ? (
                        <h1>
                            <span lang="zh">{zh("404.title")}</span>
                            <span aria-hidden="true"> / </span>
                            <span lang="en">{en("404.title")}</span>
                        </h1>
                    ) : (
                        <h1>{heroTitle}</h1>
                    )
                }
                <p class="not-found-subtitle" lang={showBoth ? "en" : lang}>
                    {heroSubtitle}
                </p>
            </header>

            <div class:list={["not-found-grid", showBoth && "is-bilingual"]}>
                {
                    panels.map(({ code, label, href, translate }) => (
                        <article class="locale-card" data-locale={code} lang={code}>
                            <div class="locale-card-top">
                                <span class="locale-badge">{label}</span>
                                <span class="locale-command">
                                    {translate("404.command.nav")}
                                </span>
                            </div>

                            <div class="locale-card-main">
                                <p class="locale-error">
                                    {translate("404.error")}
                                    <span class="cursor" aria-hidden="true"></span>
                                </p>
                                <p class="locale-message">
                                    {translate("404.message")}
                                </p>
                                <p class="locale-suggestion">
                                    {translate("404.suggestion")}
                                </p>
                            </div>

                            <footer class="locale-card-footer">
                                <a
                                    href={href}
                                    class="locale-command-link"
                                    aria-label={translate("404.link.home")}
                                >
                                    <code aria-hidden="true">
                                        {translate("404.command.home")}
                                    </code>
                                </a>
                            </footer>
                        </article>
                    ))
                }
            </div>
        </div>
    </section>
</BaseLayout>

<style>
    .not-found-shell {
        --not-found-border: color-mix(
            in srgb,
            var(--border-color) 82%,
            transparent
        );
        --not-found-paper: color-mix(
            in srgb,
            var(--surface-strong) 82%,
            var(--surface-muted)
        );
        position: relative;
        isolation: isolate;
        min-height: clamp(28rem, 66vh, 42rem);
        display: grid;
        place-items: center;
        padding: clamp(0.6rem, 2vw, 1.75rem) 0;
    }

    .not-found-glow {
        position: absolute;
        inset: auto;
        width: clamp(12rem, 28vw, 18rem);
        aspect-ratio: 1;
        border-radius: 999px;
        filter: blur(5px);
        opacity: 0.58;
        z-index: -1;
    }

    .not-found-glow-left {
        top: 5%;
        left: -4rem;
        background: radial-gradient(
            circle,
            color-mix(in srgb, var(--accent-gold) 36%, transparent),
            transparent 68%
        );
    }

    .not-found-glow-right {
        right: -4rem;
        bottom: 6%;
        background: radial-gradient(
            circle,
            color-mix(in srgb, var(--accent-berry) 28%, transparent),
            transparent 70%
        );
    }

    .not-found-frame {
        position: relative;
        overflow: hidden;
        width: min(940px, 100%);
        padding: clamp(1.4rem, 3vw, 2.3rem);
        border: 1px solid var(--not-found-border);
        border-radius: calc(var(--radius-large) + 6px);
        background:
            radial-gradient(
                circle at top left,
                color-mix(in srgb, var(--accent-gold) 20%, transparent),
                transparent 35%
            ),
            linear-gradient(145deg, var(--not-found-paper), var(--surface-muted));
        box-shadow:
            var(--shadow-md),
            inset 0 1px 0 color-mix(in srgb, var(--surface-strong) 72%, transparent);
    }

    .not-found-frame::before {
        content: "404";
        position: absolute;
        top: 1.1rem;
        right: clamp(1rem, 4vw, 2rem);
        font-size: clamp(4.6rem, 15vw, 9rem);
        font-weight: 800;
        line-height: 1;
        letter-spacing: 0.06em;
        color: color-mix(in srgb, var(--accent-strong) 12%, transparent);
        pointer-events: none;
    }

    .not-found-frame::after {
        content: "";
        position: absolute;
        inset: 0;
        background-image: radial-gradient(
            circle,
            color-mix(in srgb, var(--accent-gold) 22%, transparent) 0 0.7px,
            transparent 0.9px
        );
        background-size: 1.35rem 1.35rem;
        opacity: 0.36;
        pointer-events: none;
    }

    .not-found-hero,
    .not-found-grid {
        position: relative;
        z-index: 1;
    }

    .not-found-hero {
        max-width: 38rem;
        margin-bottom: clamp(1.25rem, 2.4vw, 1.7rem);
    }

    .not-found-hero h1 {
        margin-bottom: 0.5rem;
        text-wrap: balance;
    }

    .not-found-kicker {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        margin-bottom: 0.55rem;
        padding: 0.28rem 0.78rem;
        border: 1px solid color-mix(in srgb, var(--accent-color) 28%, transparent);
        border-radius: 999px;
        background: color-mix(in srgb, var(--surface-elevated) 82%, var(--accent-faint));
        color: var(--accent-strong);
        font-family: var(--font-mono);
        font-size: 0.86rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }

    .not-found-subtitle {
        max-width: 34rem;
        margin: 0;
        color: var(--text-soft);
        font-size: 1rem;
        text-wrap: pretty;
    }

    .not-found-grid {
        display: grid;
        gap: clamp(0.8rem, 1.8vw, 1rem);
        grid-template-columns: minmax(0, 1fr);
    }

    .not-found-grid.is-bilingual {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .locale-card {
        position: relative;
        overflow: hidden;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        min-height: 100%;
        padding: clamp(1rem, 2vw, 1.2rem);
        border: 1px solid var(--not-found-border);
        border-radius: var(--radius-medium);
        background: linear-gradient(
            180deg,
            color-mix(in srgb, var(--surface-strong) 94%, transparent),
            color-mix(in srgb, var(--surface-elevated) 88%, var(--accent-faint))
        );
        box-shadow: var(--shadow-sm);
    }

    .locale-card::before {
        content: "";
        position: absolute;
        inset: 0 auto auto 0;
        width: 100%;
        height: 3px;
        background: linear-gradient(
            90deg,
            var(--accent-gold),
            var(--accent-color),
            color-mix(in srgb, var(--accent-berry) 36%, transparent)
        );
    }

    .locale-card-top {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 0.7rem;
    }

    .locale-badge,
    .locale-command {
        display: inline-flex;
        align-items: center;
        min-height: 2rem;
        border-radius: 999px;
        font-size: 0.84rem;
    }

    .locale-badge {
        padding: 0.3rem 0.8rem;
        background: color-mix(in srgb, var(--surface-strong) 78%, var(--accent-faint));
        border: 1px solid var(--not-found-border);
        color: var(--heading-color);
        font-weight: 700;
    }

    .locale-command {
        padding: 0.3rem 0.7rem;
        background: color-mix(in srgb, var(--surface-muted) 86%, transparent);
        border: 1px dashed color-mix(in srgb, var(--accent-color) 40%, transparent);
        color: var(--text-soft);
        font-family: var(--font-mono);
    }

    .locale-card-main {
        display: grid;
        gap: 0.7rem;
    }

    .locale-error {
        margin: 0;
        color: var(--accent-text);
        font-weight: 700;
    }

    .locale-message,
    .locale-suggestion {
        margin: 0;
        color: var(--text-color);
    }

    .locale-card-footer {
        display: flex;
        justify-content: center;
        margin-top: auto;
        padding-top: 0.2rem;
    }

    .locale-command-link {
        display: inline-flex;
        max-width: 100%;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        border-radius: 999px;
    }

    .locale-command-link code {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 2.9rem;
        max-width: 100%;
        padding: 0.55rem 1rem;
        border-radius: 999px;
        border: 1px solid color-mix(in srgb, var(--accent-color) 34%, transparent);
        background: linear-gradient(
            135deg,
            color-mix(in srgb, var(--surface-elevated) 62%, var(--accent-faint)),
            color-mix(in srgb, var(--accent-faint) 74%, var(--surface-muted))
        );
        color: var(--accent-strong);
        font-family: var(--font-mono);
        font-size: 0.88rem;
        font-weight: 700;
        text-align: center;
        overflow-wrap: anywhere;
        box-shadow: 0 8px 18px color-mix(in srgb, var(--accent-strong) 16%, transparent);
        transition:
            transform var(--motion-fast) var(--ease-standard),
            box-shadow var(--motion-fast) var(--ease-standard),
            background var(--motion-fast) var(--ease-standard),
            color var(--motion-fast) var(--ease-standard);
    }

    .locale-command-link:focus-visible {
        outline: 3px solid var(--focus-ring);
        outline-offset: 4px;
    }

    .locale-command-link:focus-visible code {
        box-shadow: 0 12px 24px color-mix(in srgb, var(--accent-strong) 24%, transparent);
        background: color-mix(in srgb, var(--accent-faint) 82%, var(--surface-muted));
        color: var(--accent-strong);
    }

    @media (hover: hover) and (pointer: fine) {
        .locale-command-link:hover code {
            transform: translateY(-1px);
            box-shadow: 0 12px 24px color-mix(in srgb, var(--accent-strong) 24%, transparent);
            background: color-mix(in srgb, var(--accent-faint) 82%, var(--surface-muted));
            color: var(--accent-strong);
        }
    }

    .locale-command-link:active code {
        transform: translateY(0);
        box-shadow: 0 4px 10px color-mix(in srgb, var(--accent-strong) 16%, transparent);
    }

    .cursor {
        display: inline-block;
        width: 0.6ch;
        height: 1.15em;
        margin-left: 0.28rem;
        vertical-align: -0.14em;
        background: currentColor;
    }

    @media (max-width: 780px) {
        .not-found-grid.is-bilingual {
            grid-template-columns: minmax(0, 1fr);
        }

        .not-found-frame {
            padding: 1.2rem;
        }

        .not-found-frame::before {
            font-size: clamp(4rem, 28vw, 6.4rem);
            top: 1.35rem;
        }
    }

    @media (max-width: 480px) {
        .not-found-shell {
            min-height: 0;
        }

        .not-found-frame {
            padding: 1.05rem;
            border-radius: var(--radius-medium);
        }

        .not-found-frame::before {
            right: 0.65rem;
            opacity: 0.72;
        }

        .locale-card-top {
            align-items: flex-start;
        }

        .locale-command {
            max-width: 100%;
            overflow-wrap: anywhere;
        }
    }

    @media (prefers-contrast: more) {
        .not-found-frame,
        .locale-card {
            border-color: var(--border-color);
        }

        .not-found-frame::after {
            display: none;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .locale-command-link code {
            transition: none !important;
        }
    }
</style>

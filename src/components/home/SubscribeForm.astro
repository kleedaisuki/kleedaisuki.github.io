---
import Icon from "@components/Icon.astro";
import type { AtelierLocale } from "@i18n/atelier";

interface Props {
  locale: AtelierLocale;
}

const { locale } = Astro.props;
const copy =
  locale === "zh"
    ? {
        heading: "订阅工坊更新",
        label: "电子邮箱",
        placeholder: "name@example.com",
        button: "订阅",
        pending: "正在提交…",
        success: "请求已收到。若收到确认邮件，请按邮件指引完成订阅。",
        error: "暂时无法提交，请稍后重试。",
      }
    : {
        heading: "Get Atelier updates",
        label: "Email address",
        placeholder: "name@example.com",
        button: "Subscribe",
        pending: "Submitting…",
        success:
          "Request received. If a confirmation email arrives, follow its instructions to finish subscribing.",
        error: "We could not submit your request. Please try again later.",
      };
---

<div class="studio-subscribe framed pad">
  <h2 id={`subscribe-heading-${locale}`}>{copy.heading}</h2>
  <form action="/api/subscribe" method="post" aria-labelledby={`subscribe-heading-${locale}`} data-subscribe-form data-success={copy.success} data-error={copy.error}>
    <input type="hidden" name="locale" value={locale} />
    <label class="moe-visually-hidden" for={`subscribe-email-${locale}`}>{copy.label}</label>
    <div class="studio-subscribe__controls">
      <input class="moe-input" data-size="lg" id={`subscribe-email-${locale}`} name="email" type="email" autocomplete="email" inputmode="email" placeholder={copy.placeholder} maxlength="254" required />
      <button class="moe-button moe-button--lg" type="submit" data-pending={copy.pending}>
        <span class="moe-spinner" aria-hidden="true"></span>
        <span>{copy.button}</span>
        <Icon name="check" size={20} />
      </button>
    </div>
    <p class="studio-subscribe__status" role="status" aria-live="polite" data-subscribe-status></p>
  </form>
</div>

<script>
  /** How long the check stays before the button offers itself again. */
  const REST = 2400;

  async function post(form: HTMLFormElement): Promise<boolean> {
    const { email, locale } = Object.fromEntries(new FormData(form)) as Record<string, string>;
    const request = fetch(form.action, {
      method: "POST",
      headers: { "Content-Type": "application/json", Accept: "application/json" },
      body: JSON.stringify({ email: email?.trim(), locale }),
    });
    return request.then(({ ok }) => ok).catch(() => false);
  }

  async function submit(form: HTMLFormElement): Promise<void> {
    const status = form.querySelector<HTMLElement>("[data-subscribe-status]");
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (!status || !button || button.disabled) return;

    button.disabled = true;
    button.dataset.loading = "";
    delete form.dataset.state;
    status.textContent = button.dataset.pending ?? "";
    const accepted = await post(form);
    button.disabled = false;
    delete button.dataset.loading;

    form.dataset.state = accepted ? "sent" : "failed";
    status.textContent = (accepted ? form.dataset.success : form.dataset.error) ?? "";
    if (!accepted) return;
    form.reset();
    setTimeout(() => {
      if (form.dataset.state === "sent") delete form.dataset.state;
    }, REST);
  }

  // The native POST keeps working without this enhancement.
  for (const form of document.querySelectorAll<HTMLFormElement>("[data-subscribe-form]")) {
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      submit(form);
    });
  }
</script>

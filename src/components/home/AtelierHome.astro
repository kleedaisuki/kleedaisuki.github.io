---
import { getCollection } from "astro:content";
import Icon from "@components/Icon.astro";
import Phrases from "@components/Phrases.astro";
import DitherEdge from "@components/pixel/DitherEdge.astro";
import Hearth from "@components/pixel/Hearth.astro";
import Plate from "@components/pixel/Plate.astro";
import type { AtelierLocale } from "@i18n/atelier";
import { useTranslations } from "@i18n/utils";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getAtelierPath, getAtelierText } from "../../lib/atelier";
import { isoDay } from "../../lib/dates";
import { bedFuel, HEARTH } from "../../lib/pixel/hearth";
import { placeSparks } from "../../lib/pixel/sparks";
import { createTimeline } from "../../lib/pixel/timeline";
import { createWebSiteJsonLd, getPostPath } from "../../lib/seo";
import {
  getRecentStudioPosts,
  getRecentStudioWorks,
  getStudioMaterials,
  getStudioWorkActivity,
} from "../../lib/studio-index";
import SubscribeForm from "./SubscribeForm.astro";
import "@styles/home.css";

interface Props {
  locale: AtelierLocale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const blogPath = `/${locale}/blog/`;
const articraftsPath = `/${locale}/articrafts/`;
const allWorks = await getCollection("atelier");
const posts = getRecentStudioPosts(
  await getCollection("blog"),
  locale,
  Number.POSITIVE_INFINITY,
);
const works = getRecentStudioWorks(allWorks, Number.POSITIVE_INFINITY);
const materials = getStudioMaterials(posts, allWorks, 12);

const pieces = [
  ...posts.map(({ data }) => ({
    kind: "post" as const,
    date: data.date,
    title: data.title,
    href: getPostPath(locale, data.slug),
  })),
  ...works.map(({ data }) => ({
    kind: "work" as const,
    date: data.published,
    title: getAtelierText(data.title, locale),
    href: getAtelierPath(locale, data.slug),
  })),
].sort((left, right) => left.date.getTime() - right.date.getTime());

/** The fire has room for this many sparks; older pieces stay in the archives. */
const HEARTH_PIECES = 48;
const recent = pieces.slice(-HEARTH_PIECES);
const timeline = createTimeline(recent.map(({ date }) => date));
const { columns, rows } = HEARTH;
const sparks = placeSparks(recent, timeline, rows);
const percent = (value: number, extent: number) =>
  `${((100 * value) / extent).toFixed(2)}%`;
---

<BaseLayout pageTitle={t("home.page_title")} description={t("home.intro")} structuredData={createWebSiteJsonLd(locale)} documentLocale={locale}>
  <div class="page studio-home">
    <section class="studio-hero bleed" data-moe-surface="brand" data-hearth-field>
      <div class="studio-hero__copy framed pad">
        <h1>Atelier</h1>
        <p class="studio-hero__lead"><Phrases text={t("home.greeting")} /></p>
      </div>

      <Hearth columns={columns} rows={rows} fuel={bedFuel(timeline.profile, rows)}>
        <div class="sparks">
          {
            sparks.map(({ kind, title, href, date, column, row }) => (
              <a
                class="spark"
                data-kind={kind}
                data-piece={href}
                data-date={isoDay(date)}
                data-title={title}
                href={href}
                tabindex="-1"
                style={`left:${percent(column, columns)};top:${percent(row, rows)}`}
              />
            ))
          }
          <p class="spark-label" data-spark-label></p>
        </div>
        <div class="hearth-axis">
          {
            timeline.quarters.map((date) => (
              <span style={`left:${percent(timeline.columnOf(date), columns)}`} data-year={date.getUTCMonth() === 0 || undefined}>
                {isoDay(date).slice(0, 7)}
              </span>
            ))
          }
        </div>
      </Hearth>
    </section>

    <div class="studio-doors">
      <section class="studio-door pad" aria-labelledby="door-blog">
        <header class="studio-door__head">
          <h2 id="door-blog"><a href={blogPath}><span class="mark" data-kind="post"></span>Blog <Icon name="arrow-right" size={20} /></a></h2>
        </header>
        <ol class="studio-list">
          {
            posts.slice(0, 8).map(({ data }) => (
              <li class="row-link" data-piece={getPostPath(locale, data.slug)}>
                <time datetime={data.date.toISOString()}>{isoDay(data.date)}</time>
                <h3><a href={getPostPath(locale, data.slug)}><Phrases text={data.title} /></a></h3>
              </li>
            ))
          }
        </ol>
        {posts.length === 0 && <p>{t("home.empty_writing")}</p>}
      </section>

      <section class="studio-door pad" aria-labelledby="door-articrafts">
        <header class="studio-door__head">
          <h2 id="door-articrafts"><a href={articraftsPath}><span class="mark" data-kind="work"></span>Articrafts <Icon name="arrow-right" size={20} /></a></h2>
        </header>
        <ol class="studio-list studio-list--works">
          {
            works.slice(0, 4).map((work) => {
              const activity = getStudioWorkActivity(work);
              const { slug, cover } = work.data;
              return (
                <li class="row-link" data-piece={getAtelierPath(locale, slug)}>
                  <div class="studio-list__plate" style={`view-transition-name:plate-${slug}`}>
                    {cover ? <img src={cover} alt="" loading="lazy" /> : <Plate seed={slug} />}
                  </div>
                  <div>
                    <h3><a href={getAtelierPath(locale, slug)}><Phrases text={getAtelierText(work.data.title, locale)} /></a></h3>
                    <time datetime={activity.toISOString()}>{isoDay(activity)}</time>
                  </div>
                </li>
              );
            })
          }
        </ol>
        {works.length === 0 && <p>{t("home.empty_articrafts")}</p>}
      </section>
    </div>

    {
      materials.length > 0 && (
        <section class="studio-materials pad">
          <ul class="tag-list" aria-label={t("home.materials_title")}>{materials.map((material) => <li>{material}</li>)}</ul>
        </section>
      )
    }

    <section class="studio-closing bleed" data-moe-surface="brand">
      <DitherEdge side="top" />
      <SubscribeForm locale={locale} />
    </section>
  </div>
</BaseLayout>

<script>
  // A spark in the fire and its row in a list are one piece: touching either lights both.
  const home = document.querySelector<HTMLElement>(".studio-home");
  const label = document.querySelector<HTMLElement>("[data-spark-label]");
  const marks = [...document.querySelectorAll<HTMLElement>("[data-piece]")];
  const WARMTH = 0.45;
  let lit: string | undefined;

  function name(spark: HTMLElement): void {
    if (!label) return;
    const date = document.createElement("time");
    date.textContent = spark.dataset.date ?? "";
    label.replaceChildren(date, spark.dataset.title ?? "");
    label.style.left = spark.style.left;
    label.style.top = spark.style.top;
    // Shifting by the same share keeps the label inside the fire at either end.
    label.style.setProperty("--shift", spark.style.left);
    void label.offsetWidth;
    label.dataset.active = "";
  }

  function warm(spark: HTMLElement): void {
    const { x, y } = spark.getBoundingClientRect();
    const detail = { x, y, power: WARMTH };
    spark.dispatchEvent(new CustomEvent("hearth:stoke", { bubbles: true, detail }));
  }

  function light(piece: string | undefined, named = false): void {
    if (piece === lit) return;
    lit = piece;
    delete label?.dataset.active;
    for (const mark of marks) mark.toggleAttribute("data-active", piece !== undefined && mark.dataset.piece === piece);
    const spark = home?.querySelector<HTMLElement>(".spark[data-active]");
    if (!spark) return;
    warm(spark);
    if (named) name(spark);
  }

  const pieceOf = (target: EventTarget | null): string | undefined =>
    target instanceof Element ? target.closest<HTMLElement>("[data-piece]")?.dataset.piece : undefined;

  const isSpark = (target: EventTarget | null): boolean => target instanceof Element && target.matches(".spark");

  // A row already shows its title, so only a spark needs the label.
  home?.addEventListener("pointerover", ({ target }) => light(pieceOf(target), isSpark(target)));
  home?.addEventListener("pointerleave", () => light(undefined));
  home?.addEventListener("focusin", ({ target }) => light(pieceOf(target)));
  home?.addEventListener("focusout", () => light(undefined));
</script>

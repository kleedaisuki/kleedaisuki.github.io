---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getPublishedAlternates } from "../lib/localized-blog";

const pathname = Astro.url.pathname;
const m = pathname.match(/^\/(zh|en)\/blog\/([^/]+)\/?$/);
const currentLocale = pathname.match(/^\/(zh|en)(?:\/|$)/)?.[1] as
  | "zh"
  | "en"
  | undefined;

const raw = pathname.replace(/^\/(zh|en)\//, "");
let toZH: string | undefined = getRelativeLocaleUrl("zh", raw);
let toEN: string | undefined = getRelativeLocaleUrl("en", raw);

if (m) {
  const postLocale = m[1] as "zh" | "en";
  const currentSlug = decodeURIComponent(m[2]);
  const allPosts = await getCollection("blog", ({ data }) => !data.draft);
  const publishedAlternates = getPublishedAlternates(
    allPosts,
    postLocale,
    currentSlug,
  );
  const zhAlternate = publishedAlternates.find(
    (alternate) => alternate.locale === "zh",
  );
  const enAlternate = publishedAlternates.find(
    (alternate) => alternate.locale === "en",
  );

  toZH = zhAlternate
    ? `/zh/blog/${encodeURIComponent(zhAlternate.slug)}/`
    : undefined;
  toEN = enAlternate
    ? `/en/blog/${encodeURIComponent(enAlternate.slug)}/`
    : undefined;
}
---

<nav
    class="lang-switch"
    aria-label={currentLocale === "zh" ? "语言切换" : "Language switcher"}
>
    {
        toZH && (
            <a
                href={toZH}
                hreflang="zh"
                aria-current={currentLocale === "zh" ? "page" : undefined}
                onclick="try{localStorage.setItem('prefLocale','zh')}catch(e){}">中文</a
            >
        )
    }
    {toZH && toEN && <span aria-hidden="true">|</span>}
    {
        toEN && (
            <a
                href={toEN}
                hreflang="en"
                aria-current={currentLocale === "en" ? "page" : undefined}
                onclick="try{localStorage.setItem('prefLocale','en')}catch(e){}"
                >English</a
            >
        )
    }
</nav>

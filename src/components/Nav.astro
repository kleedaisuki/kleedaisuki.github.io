---
import { asLocale, type Locale, t } from "@i18n/t";

interface Props {
  locale?: Locale;
}
const locale = Astro.props.locale ?? asLocale(Astro.currentLocale);
const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const homePath = `/${locale}/`;
const links = [
  { href: `/${locale}/blog/`, label: t("blog", locale) },
  { href: `/${locale}/articrafts/`, label: t("atelier", locale) },
  {
    href: "https://me.moesegfault.dev",
    label: locale === "zh" ? "关于 ↗" : "About ↗",
    rel: "me external",
  },
];

/** A section stays current on every page beneath it. */
const isWithin = (href: string) => `${currentPath}/`.startsWith(href);
---

<nav class="site-nav" aria-label={locale === "zh" ? "主导航" : "Primary navigation"}>
  <a class="site-brand moe-brand-mark" href={homePath} aria-current={`${currentPath}/` === homePath ? "page" : undefined}>
    <span class="moe-brand-mark__symbol" aria-hidden="true">
      <svg viewBox="0 0 64 64" fill="currentColor"><path d="M18 13h9v14.4L40.2 13H51L35.7 30.2 52 51H40.6L28.3 35.3 27 36.7V51h-9V13Z" /><path class="moe-brand-mark__spark" d="m49.5 7 1.8 4.7L56 13.5l-4.7 1.8L49.5 20l-1.8-4.7-4.7-1.8 4.7-1.8L49.5 7Z" /></svg>
    </span>
    <span class="moe-brand-mark__name">Atelier</span>
  </a>
  <div class="site-nav__links slider">
    {
      links.map(({ href, label, rel }) => (
        <a href={href} rel={rel} aria-current={isWithin(href) ? "page" : undefined}>{label}</a>
      ))
    }
  </div>
</nav>

<script is:inline>
  (() => {
    const locale = location.pathname.match(/^\/(zh|en)(?:\/|$)/)?.[1];
    if (!locale) return;
    try {
      localStorage.setItem("prefLocale", locale);
    } catch {
      // Without storage the root path falls back to the browser language.
    }
  })();
</script>

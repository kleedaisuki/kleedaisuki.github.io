---
import CopyButton from "@components/CopyButton.astro";
import Icon from "@components/Icon.astro";
import { ATELIER_COPY, type AtelierLocale } from "@i18n/atelier";
import {
  type AtelierText,
  formatFileSize,
  getAtelierText,
  getFileCapability,
  getPdfReaderUrl,
  getReleaseFileUrl,
} from "../../lib/atelier";

interface AtelierFile {
  id: string;
  label: AtelierText;
  path: string;
  mediaType?: string;
  description?: AtelierText;
  size?: number;
  checksum?: string;
  available?: boolean;
}

interface Props {
  locale: AtelierLocale;
  slug: string;
  version: string;
  files: AtelierFile[];
}
const { locale, slug, version, files } = Astro.props;
const copy = ATELIER_COPY[locale];

const items = files.map((file) => ({
  ...file,
  title: getAtelierText(file.label, locale),
  note: file.description && getAtelierText(file.description, locale),
  extension: file.path.match(/\.([^./]+)$/)?.[1]?.toUpperCase(),
  downloadUrl: getReleaseFileUrl(slug, version, file),
  readerUrl:
    getFileCapability(file).kind === "pdf"
      ? getPdfReaderUrl(locale, slug, version, file.id)
      : undefined,
  isAvailable: file.available !== false,
}));
---

<ul class="file-list moe-panel">
  {
    items.map((file) => (
      <li class="file-item">
        <Icon name="file" size={20} class="file-item__icon" />
        <div class="file-item__content">
          <p class="file-item__title">{file.title}</p>
          {file.note && <p class="file-item__description">{file.note}</p>}
          <p class="file-item__meta">
            {file.extension && <span>{file.extension}</span>}
            {file.size !== undefined && <span>{formatFileSize(file.size)}</span>}
          </p>
          {file.checksum && (
            <div class="file-item__checksum">
              <code>{file.checksum}</code>
              <CopyButton locale={locale} subject="SHA-256" text={file.checksum} />
            </div>
          )}
        </div>
        <div class="file-item__actions">
          {!file.isAvailable && <span class="atelier-note" role="status">{copy.fileUnavailable}</span>}
          {file.isAvailable && file.readerUrl && <a class="moe-button" href={file.readerUrl}>{copy.readOnline}</a>}
          {file.isAvailable && (
            <a class="moe-button moe-button--secondary" href={file.downloadUrl} download><Icon name="download" />{copy.download}</a>
          )}
        </div>
      </li>
    ))
  }
</ul>

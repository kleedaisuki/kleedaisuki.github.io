---
import {
  formatFileSize,
  getFileCapability,
  getPdfReaderUrl,
  getReleaseFileUrl,
} from "../../lib/atelier";

/** @brief Atelier 文件描述 / Atelier file descriptor. */
interface AtelierFile {
  id: string;
  label: string;
  path: string;
  mediaType?: string;
  description?: string;
  size?: number;
  checksum?: string;
  available?: boolean;
}

/** @brief 文件列表属性 / File-list properties. */
interface Props {
  slug: string;
  version: string;
  files: AtelierFile[];
}

const { slug, version, files } = Astro.props as Props;

/** @brief 文件用途分组 / Purpose-oriented file group. */
interface FileGroup {
  id: string;
  label: string;
  files: AtelierFile[];
}

/**
 * @brief 推导面向读者的文件用途 / Infer a reader-facing file purpose.
 * @param file 文件描述 / File descriptor.
 * @return 分组标识 / Group identifier.
 */
function getGroup(file: AtelierFile): string {
  const mediaType = file.mediaType?.toLocaleLowerCase() ?? "";
  const path = file.path.toLocaleLowerCase();
  const capability = getFileCapability(file);

  if (capability.kind === "pdf") return "documents";
  if (
    mediaType.startsWith("text/") ||
    /\.(?:c|cc|cpp|cs|css|go|h|hpp|html|java|js|jsx|kt|md|py|rs|sh|ts|tsx)$/.test(
      path,
    )
  )
    return "source";
  if (
    mediaType.includes("csv") ||
    mediaType.includes("json") ||
    /\.(?:csv|json|parquet|tsv)$/.test(path)
  )
    return "data";
  return "other";
}

/** @brief 固定顺序的非空文件分组 / Non-empty file groups in stable order. */
const groups: FileGroup[] = [
  { id: "documents", label: "Documents", files: [] },
  { id: "source", label: "Source", files: [] },
  { id: "data", label: "Data", files: [] },
  { id: "other", label: "Other downloads", files: [] },
];

for (const file of files) {
  groups.find((group) => group.id === getGroup(file))?.files.push(file);
}
---

<div class="file-groups">
  {
    groups.filter((group) => group.files.length > 0).map((group) => (
      <section class="file-group" aria-labelledby={`file-group-${group.id}-${version}`}>
        <h3 id={`file-group-${group.id}-${version}`}>{group.label}</h3>
        <ul class="file-list">
          {group.files.map((file) => {
            const capability = getFileCapability(file);
            const downloadUrl = getReleaseFileUrl(slug, version, file);
            const isPdf = capability.kind === "pdf";
            const isAvailable = file.available !== false;

            return (
              <li class="file-item">
                <div class="file-item__content">
                  <p class="file-item__title">{file.label}</p>
                  {file.description && <p class="file-item__description">{file.description}</p>}
                  <dl class="file-item__meta">
                    {file.mediaType && (
                      <div><dt>Format</dt><dd>{file.mediaType}</dd></div>
                    )}
                    {file.size !== undefined && (
                      <div><dt>Size</dt><dd>{formatFileSize(file.size)}</dd></div>
                    )}
                    {file.checksum && (
                      <div class="file-item__checksum">
                        <dt>SHA-256</dt><dd><code>{file.checksum}</code></dd>
                      </div>
                    )}
                  </dl>
                </div>
                <div class="file-item__actions">
                  {!isAvailable ? (
                    <span class="atelier-inline-empty" role="status">File unavailable</span>
                  ) : isPdf ? (
                    <a class="atelier-button atelier-button--primary" href={getPdfReaderUrl(slug, version, file.id)}>
                      Read online
                    </a>
                  ) : null}
                  {isAvailable && (
                    <a class="atelier-button" href={downloadUrl} download>
                      Download
                    </a>
                  )}
                </div>
              </li>
            );
          })}
        </ul>
      </section>
    ))
  }
</div>

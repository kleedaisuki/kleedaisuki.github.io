---
import CopyButton from "@components/CopyButton.astro";
import Icon from "@components/Icon.astro";
import { ATELIER_COPY, type AtelierLocale } from "@i18n/atelier";

/** @brief 源码查看器属性 (source viewer properties) / Properties accepted by the source viewer. */
interface Props {
  locale: AtelierLocale;
  path: string;
  sizeLabel: string;
  rawUrl: string;
  archiveUrl: string;
  highlightedHtml?: string;
  previewNote?: string;
}

/** @brief 当前源码文件显示数据 (current source display data) / Display data for the selected source file. */
const {
  locale,
  path,
  sizeLabel,
  rawUrl,
  archiveUrl,
  highlightedHtml,
  previewNote,
} = Astro.props as Props;
/** @brief 当前源码查看器文案 / Current localized source-viewer copy. */
const copy = ATELIER_COPY[locale];
---

<article
  class="source-viewer"
  data-source-viewer
>
  <header class="source-viewer__header">
    <div>
      <h2>{path}</h2>
      <span class="source-viewer__size">{sizeLabel}</span>
    </div>
    <div class="source-viewer__actions">
      {
        highlightedHtml && <CopyButton locale={locale} subject={path} from="[data-source-code] code" />
      }
      <a class="moe-button moe-button--ghost moe-button--sm" href={rawUrl} download><Icon name="download" size={14} />{copy.downloadFile}</a>
      <a class="moe-button moe-button--ghost moe-button--sm" href={archiveUrl} download><Icon name="download" size={14} />ZIP</a>
    </div>
  </header>

  {
    highlightedHtml ? (
      <div class="source-viewer__code" data-source-code set:html={highlightedHtml} />
    ) : (
      <div class="source-viewer__unavailable">
        <p>{previewNote ?? copy.previewUnavailable}</p>
      </div>
    )
  }
</article>

---
/** @brief 源码目录树节点 (source tree node) / Node in the source directory tree. */
export interface SourceTreeNode {
  /** @brief 显示名称 (display name) / Human-readable node name. */
  name: string;
  /** @brief 相对源码路径 (relative source path) / Relative path inside the source release. */
  path: string;
  /** @brief 节点类型 (node kind) / Whether this node is a file or directory. */
  type: "file" | "directory";
  /** @brief 子节点 (child nodes) / Children of a directory node. */
  children?: SourceTreeNode[];
}

/** @brief 源码目录树属性 (source tree properties) / Properties accepted by the source tree. */
interface Props {
  nodes: SourceTreeNode[];
  activePath?: string;
  sourceBase: string;
  nested?: boolean;
}

/**
 * @brief 将源码路径编码为稳定 URL (stable source URL encoding) / Encode a source path without hiding its directory structure.
 * @param path 相对源码路径 (relative source path) / Source-relative path to encode.
 * @return 保留目录层级的 URL 路径 / URL path preserving directory boundaries.
 */
const encodeSourcePath = (path: string): string =>
  path.split("/").map(encodeURIComponent).join("/");

/** @brief 当前目录树属性 (current tree properties) / Properties for this recursive render pass. */
const { nodes, activePath, sourceBase, nested = false } = Astro.props as Props;

/**
 * @brief 判断目录是否包含当前文件 (active-descendant test) / Return whether a directory contains the active file.
 * @param node 待判断的目录树节点 (tree node to inspect) / Directory-tree node being tested.
 * @return 当前文件等于或位于节点下方时为 true / True when the active file is the node or its descendant.
 */
const containsActiveFile = (node: SourceTreeNode): boolean =>
  activePath === node.path || activePath?.startsWith(`${node.path}/`) === true;
---

{
  !nested ? (
    <details class="source-tree-shell">
      <summary>Source files</summary>
      <nav aria-label="Source files" class="source-tree-panel">
        <ul class="source-tree" role="list">
          {
            nodes.map((node) =>
              node.type === "directory" ? (
                <li class="source-tree__directory">
                  <details open={containsActiveFile(node)}>
                    <summary>
                      <span class="source-tree__chevron" aria-hidden="true">▸</span>
                      {node.name}
                    </summary>
                    <Astro.self
                      nodes={node.children ?? []}
                      activePath={activePath}
                      sourceBase={sourceBase}
                      nested
                    />
                  </details>
                </li>
              ) : (
                <li class="source-tree__file">
                  <a
                    href={`${sourceBase}/${encodeSourcePath(node.path)}/`}
                    aria-current={activePath === node.path ? "page" : undefined}
                  >
                    <span aria-hidden="true">◇</span>
                    {node.name}
                  </a>
                </li>
              ),
            )
          }
        </ul>
      </nav>
    </details>
  ) : (
    <ul class="source-tree" role="list">
      {
        nodes.map((node) =>
          node.type === "directory" ? (
            <li class="source-tree__directory">
              <details open={containsActiveFile(node)}>
                <summary>
                  <span class="source-tree__chevron" aria-hidden="true">▸</span>
                  {node.name}
                </summary>
                <Astro.self
                  nodes={node.children ?? []}
                  activePath={activePath}
                  sourceBase={sourceBase}
                  nested
                />
              </details>
            </li>
          ) : (
            <li class="source-tree__file">
              <a
                href={`${sourceBase}/${encodeSourcePath(node.path)}/`}
                aria-current={activePath === node.path ? "page" : undefined}
              >
                <span aria-hidden="true">◇</span>
                {node.name}
              </a>
            </li>
          ),
        )
      }
    </ul>
  )
}

---
import Phrases from "@components/Phrases.astro";
import Plate from "@components/pixel/Plate.astro";
import type { AtelierLocale } from "@i18n/atelier";
import { getAtelierPath } from "../../lib/atelier";
import { isoDay } from "../../lib/dates";

interface Props {
  locale: AtelierLocale;
  slug: string;
  title: string;
  summary: string;
  activityDate: Date;
  cover?: string;
  types: string[];
}
const { locale, slug, title, summary, activityDate, cover, types } =
  Astro.props;
---

<article class="atelier-card" data-work-card data-types={JSON.stringify(types.map((type) => type.toLocaleLowerCase()))}>
  <div class="atelier-card__plate" style={`view-transition-name:plate-${slug}`}>
    {cover ? <img src={cover} alt="" loading="lazy" decoding="async" /> : <Plate seed={slug} />}
  </div>
  <div class="atelier-card__body">
    <time datetime={activityDate.toISOString()}>{isoDay(activityDate)}</time>
    <h2><a href={getAtelierPath(locale, slug)}><Phrases text={title} /></a></h2>
    <p class="atelier-card__summary">{summary}</p>
  </div>
</article>

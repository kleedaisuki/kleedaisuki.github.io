---
import type { CollectionEntry } from "astro:content";
import { ATELIER_COPY, type AtelierLocale } from "@i18n/atelier";
import {
  DEFAULT_ATELIER_COVER,
  getAtelierPath,
  getAtelierText,
  getLatestRelease,
} from "../../lib/atelier";
import FileList from "./FileList.astro";

/** @brief Atelier 条目的发布版本 / Release type inferred from an Atelier entry. */
type AtelierRelease = CollectionEntry<"atelier">["data"]["releases"][number];

/** @brief 作品详情属性 / Work-detail properties. */
interface Props {
  locale: AtelierLocale;
  entry: CollectionEntry<"atelier">;
  release?: AtelierRelease;
  sourcePath?: string;
  sourceArchivePath?: string;
}

const { locale, entry, release, sourcePath, sourceArchivePath } =
  Astro.props as Props;
/** @brief 当前详情页文案 / Current localized detail-page copy. */
const copy = ATELIER_COPY[locale];
/** @brief 当前语言的作品标题 / Localized work title. */
const title = getAtelierText(entry.data.title, locale);
/** @brief 当前语言的作品摘要 / Localized work summary. */
const summary = getAtelierText(entry.data.summary, locale);
/** @brief 当前语言的作品正文 / Work prose in the current locale. */
const about = entry.data.about?.[locale];
/** @brief 作品封面或统一默认封面 / Work cover or the shared default cover. */
const coverUrl = entry.data.cover ?? DEFAULT_ATELIER_COVER;
/** @brief 作品的最新发布版本 / Latest release of the work. */
const latestRelease = getLatestRelease(entry.data.releases);
/** @brief 当前是否展示最新版本 / Whether the selected release is current. */
const isLatest = Boolean(
  release && latestRelease && release.version === latestRelease.version,
);
/** @brief 作品详情的稳定地址 / Stable work-detail URL. */
const workPath = getAtelierPath(locale, entry.data.slug);
/** @brief 作品事件日期格式器 / Work timeline date formatter. */
const dateFormatter = new Intl.DateTimeFormat(
  locale === "zh" ? "zh-CN" : "en",
  {
    year: "numeric",
    month: "long",
    day: "numeric",
  },
);
/** @brief 按发布日期倒序的版本历史 / Release history ordered newest first. */
const releaseHistory = [...entry.data.releases].sort(
  (left, right) => right.date.getTime() - left.date.getTime(),
);
---

<div class="atelier-detail">
  <nav class="atelier-breadcrumb" aria-label={copy.breadcrumb}>
    <ol>
      <li><a href={`/${locale}/articrafts/`}>{copy.atelier}</a></li>
      <li aria-current="page">{title}</li>
    </ol>
  </nav>

  <header class="atelier-detail__hero">
    <div class="atelier-detail__cover">
      <img src={coverUrl} alt="" decoding="async" />
    </div>
    <div class="atelier-detail__intro">
      <p class="atelier-eyebrow">{copy.artifact} / {entry.data.slug}</p>
      <h1 id="work-title">{title}</h1>
      <p class="atelier-detail__summary">{summary}</p>
      <dl class="atelier-detail__facts">
        <div>
          <dt>{copy.published}</dt>
          <dd><time datetime={entry.data.published.toISOString()}>{dateFormatter.format(entry.data.published)}</time></dd>
        </div>
        {entry.data.updated && (
          <div>
            <dt>{copy.updated}</dt>
            <dd><time datetime={entry.data.updated.toISOString()}>{dateFormatter.format(entry.data.updated)}</time></dd>
          </div>
        )}
        {latestRelease && (
          <div>
            <dt>{copy.latestRelease}</dt>
            <dd>v{latestRelease.version}</dd>
          </div>
        )}
      </dl>
      {entry.data.tags.length > 0 && (
        <ul class="atelier-tags" aria-label={copy.workTags}>
          {entry.data.tags.map((tag) => <li>{tag}</li>)}
        </ul>
      )}
    </div>
  </header>

  <div class="atelier-detail__layout">
    <div class="atelier-detail__main">
      <section class="atelier-panel atelier-description" aria-labelledby="about-this-work">
        <p class="atelier-section-index">01 / {copy.made}</p>
        <h2 id="about-this-work">{copy.aboutWork}</h2>
        <div class="atelier-prose">
          {about ? about.map((paragraph) => <p>{paragraph}</p>) : <slot />}
        </div>
      </section>

      <section class="atelier-panel" aria-labelledby="files-heading">
        <div class="atelier-section-heading">
          <div>
            <p class="atelier-section-index">02 / {copy.materials}</p>
            <h2 id="files-heading">
              {release ? `${locale === "zh" ? "版本" : "Version"} ${release.version}` : copy.noRelease}
            </h2>
          </div>
          {release && !isLatest && <a href={workPath}>{copy.viewLatest}</a>}
        </div>
        {release?.notes && <p class="atelier-release-note">{getAtelierText(release.notes, locale)}</p>}
        {release && sourcePath && (
          <p class="atelier-source-actions">
            <a class="atelier-button atelier-button--primary" href={sourcePath}>{copy.browseSource}</a>
            {sourceArchivePath && <a class="atelier-button" href={sourceArchivePath} download>{copy.downloadSourceZip}</a>}
          </p>
        )}
        {release && release.files.length > 0 ? (
          <FileList locale={locale} slug={entry.data.slug} version={release.version} files={release.files} />
        ) : (
          <p class="atelier-inline-empty">{copy.noFiles}</p>
        )}
      </section>
    </div>

    <aside class="atelier-detail__aside" aria-label={copy.workInformation}>
      <section class="atelier-panel atelier-panel--compact">
        <p class="atelier-section-index">03 / {copy.versions}</p>
        <h2>{copy.versionHistory}</h2>
        {entry.data.releases.length > 0 ? (
          <ol class="version-list">
            {releaseHistory.map((item) => {
              const selected = release?.version === item.version;
              const versionUrl = `${workPath}${encodeURIComponent(item.version)}/`;
              return (
                <li class:list={{ "version-list__item--current": selected }}>
                  <div>
                    {selected ? (
                      <strong aria-current="page">v{item.version}</strong>
                    ) : (
                      <a href={versionUrl}>v{item.version}</a>
                    )}
                    {item.version === latestRelease?.version && <span class="version-badge">{copy.latest}</span>}
                  </div>
                  <time datetime={item.date.toISOString()}>{dateFormatter.format(item.date)}</time>
                  {item.notes && <p>{getAtelierText(item.notes, locale)}</p>}
                </li>
              );
            })}
          </ol>
        ) : (
          <p class="atelier-inline-empty">{copy.noReleases}</p>
        )}
      </section>

      <section class="atelier-panel atelier-panel--compact">
        <h2>{copy.linksAndLicense}</h2>
        <dl class="atelier-link-list">
          <div>
            <dt>{copy.license}</dt>
            <dd>{entry.data.license ?? copy.licenseNotSpecified}</dd>
          </div>
          {entry.data.repository && (
            <div>
              <dt>{copy.repository}</dt>
              <dd><a href={entry.data.repository}>{copy.viewRepository}</a></dd>
            </div>
          )}
          {entry.data.relatedPost && (
            <div>
              <dt>{copy.fromBlog}</dt>
              <dd><a href={entry.data.relatedPost}>{copy.readRelatedPost}</a></dd>
            </div>
          )}
        </dl>
      </section>
    </aside>
  </div>
</div>

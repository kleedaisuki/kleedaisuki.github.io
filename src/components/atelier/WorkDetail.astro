---
import type { CollectionEntry } from "astro:content";
import Icon from "@components/Icon.astro";
import Phrases from "@components/Phrases.astro";
import Plate from "@components/pixel/Plate.astro";
import { ATELIER_COPY, type AtelierLocale } from "@i18n/atelier";
import {
  getAtelierPath,
  getAtelierText,
  getLatestRelease,
} from "../../lib/atelier";
import { isoDay } from "../../lib/dates";
import FileList from "./FileList.astro";

type AtelierRelease = CollectionEntry<"atelier">["data"]["releases"][number];

interface Props {
  locale: AtelierLocale;
  entry: CollectionEntry<"atelier">;
  release?: AtelierRelease;
  sourcePath?: string;
  sourceArchivePath?: string;
}
const { locale, entry, release, sourcePath, sourceArchivePath } = Astro.props;
const {
  slug,
  cover,
  published,
  tags,
  license,
  repository,
  relatedPost,
  releases,
} = entry.data;
const copy = ATELIER_COPY[locale];
const title = getAtelierText(entry.data.title, locale);
const summary = getAtelierText(entry.data.summary, locale);
const about = entry.data.about?.[locale];
const latestRelease = getLatestRelease(releases);
const isLatest =
  release !== undefined && release.version === latestRelease?.version;
const workPath = getAtelierPath(locale, slug);
const history = releases.toSorted(
  (left, right) => right.date.getTime() - left.date.getTime(),
);
---

<div class="page atelier-detail">
  <header class="atelier-detail__hero">
    <div class="atelier-detail__intro pad">
      <h1 id="work-title"><Phrases text={title} /></h1>
      <p class="atelier-detail__summary">{summary}</p>
      {tags.length > 0 && <ul class="tag-list" aria-label={copy.workTags}>{tags.map((tag) => <li>{tag}</li>)}</ul>}
    </div>
    <div class="atelier-detail__plate" style={`view-transition-name:plate-${slug}`}>
      {cover ? <img src={cover} alt="" decoding="async" /> : <Plate seed={slug} />}
    </div>
  </header>

  <div class="atelier-detail__layout">
    <div class="atelier-detail__main">
      <section class="atelier-section pad" aria-labelledby="files-heading">
        <h2 class="moe-visually-hidden" id="files-heading">{release ? `${copy.materials} v${release.version}` : copy.noRelease}</h2>
        {release && !isLatest && <p class="atelier-notice"><span class="mono">v{release.version}</span><a href={workPath}>{copy.viewLatest}</a></p>}
        {release && sourcePath && (
          <p class="atelier-actions">
            <a class="moe-button moe-button--secondary" href={sourcePath}>{copy.browseSource}</a>
            {sourceArchivePath && <a class="moe-button moe-button--ghost" href={sourceArchivePath} download><Icon name="download" />{copy.downloadSourceZip}</a>}
          </p>
        )}
        {release && release.files.length > 0 ? (
          <FileList locale={locale} slug={slug} version={release.version} files={release.files} />
        ) : (
          <p class="atelier-note">{copy.noFiles}</p>
        )}
      </section>

      <section class="atelier-section pad" aria-labelledby="about-this-work">
        <h2 class="moe-visually-hidden" id="about-this-work">{copy.aboutWork}</h2>
        <div class="prose moe-prose">
          {about ? about.map((paragraph) => <p>{paragraph}</p>) : <slot />}
        </div>
      </section>
    </div>

    <aside class="atelier-detail__aside" aria-label={copy.workInformation}>
      <section class="pad" aria-labelledby="version-history">
        <h2 class="moe-visually-hidden" id="version-history">{copy.versionHistory}</h2>
        {history.length > 0 ? (
          <ol class="version-list">
            {history.map((item) => {
              const selected = release?.version === item.version;
              return (
                <li data-selected={selected || undefined}>
                  <div>
                    {selected ? (
                      <strong aria-current="page">v{item.version}</strong>
                    ) : (
                      <a href={`${workPath}${encodeURIComponent(item.version)}/`}>v{item.version}</a>
                    )}
                    <time datetime={item.date.toISOString()}>{isoDay(item.date)}</time>
                  </div>
                  {item.notes && <p>{getAtelierText(item.notes, locale)}</p>}
                </li>
              );
            })}
          </ol>
        ) : (
          <time datetime={published.toISOString()}>{isoDay(published)}</time>
        )}
      </section>
      {(license || repository || relatedPost) && (
        <ul class="atelier-links pad">
          {repository && <li><a href={repository}>{copy.repository}<Icon name="arrow-up-right" /></a></li>}
          {relatedPost && <li><a href={relatedPost}>{copy.fromBlog}<Icon name="arrow-right" /></a></li>}
          {license && <li>{license}</li>}
        </ul>
      )}
    </aside>
  </div>
</div>
